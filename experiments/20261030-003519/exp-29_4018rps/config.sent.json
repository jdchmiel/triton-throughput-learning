{
  "name": "miniLM-onnx",
  "platform": "onnxruntime_onnx",
  "backend": "onnxruntime",
  "runtime": "",
  "version_policy": {
    "latest": {
      "num_versions": 1
    }
  },
  "max_batch_size": 128,
  "input": [
    {
      "name": "input_ids",
      "data_type": "TYPE_INT64",
