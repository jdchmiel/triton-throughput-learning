      "is_shape_tensor": false,
      "allow_ragged_batch": false,
      "optional": false,
      "is_non_linear_format_io": false
    },
    {
      "name": "attention_mask",
      "data_type": "TYPE_INT64",
      "format": "FORMAT_NONE",
      "dims": [
        -1
      ],
      "is_shape_tensor": false,
      "allow_ragged_batch": false,
      "optional": false,
      "is_non_linear_format_io": false
    },
    {
      "name": "token_type_ids",
      "data_type": "TYPE_INT64",
      "format": "FORMAT_NONE",
      "dims": [
        -1
      ],
      "is_shape_tensor": false,
      "allow_ragged_batch": false,
      "optional": false,
      "is_non_linear_format_io": false
    }
  ],
  "output": [
    {
      "name": "last_hidden_state",
      "data_type": "TYPE_FP32",
      "dims": [
        -1,
