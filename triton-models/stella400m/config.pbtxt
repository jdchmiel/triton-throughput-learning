# Stella 400M (NovaSearch/stella_en_400M_v5) embedding service.
#
# Text in, unit-length 1024-d vector out, and nothing else. This matches
# production: the service returns embeddings. There is no corpus and no
# similarity scoring here -- whatever consumes the vectors is the caller's job.
#
# Everything needed to serve this model is vendored in this repo except the
# 1.7 GB model.safetensors, which must be downloaded into 1/ (see README).
#
# The python backend has no torch in the Triton image, so it borrows the
# existing miniLM virtualenv rather than shipping a second 3 GB copy. That env
# carries transformers 5.x, which needs the two compatibility shims in
# 1/model.py; see the module docstring before changing the load path.
#
# Sweep knobs live in parameters so a campaign can rewrite them without
# touching model.py:
#   DTYPE               float16 (default) | float32
#   PROMPT_MODE         always (query side, default) | never (passage side)
#   ATTN_IMPLEMENTATION "" (eager, what the checkpoint was trained with) | sdpa
#   MAX_LENGTH          tokenizer truncation cap
#   TORCH_THREADS       pins the CPU thread pool for multi-instance runs

name: "stella400m"
backend: "python"
max_batch_size: 128

dynamic_batching {
  preferred_batch_size: [ 2, 4, 8, 16, 32, 64, 128 ]
  max_queue_delay_microseconds: 5000
}

instance_group [
  {
    count: 1
    kind: KIND_GPU
  }
]

parameters: {
  key: "EXECUTION_ENV_PATH"
  value: { string_value: "/opt/ml/model/miniLM/minilm_env.tar.gz" }
}

parameters: {
  key: "DTYPE"
  value: { string_value: "float16" }
}

# Stella is asymmetric: the instruct prompt belongs on the query side only.
# This deployment applies it by default; a caller that needs passage-side
# encoding sends USE_PROMPT=0 per request. Vectors encoded with and without the
# prompt are not comparable to each other, so whichever side a caller is
# encoding, it has to stay consistent on that side.
parameters: {
  key: "PROMPT_MODE"
  value: { string_value: "always" }
}

parameters: {
  key: "MAX_LENGTH"
  value: { string_value: "512" }
}

parameters: {
  key: "TORCH_THREADS"
  value: { string_value: "0" }
}

input [
  {
    name: "TEXT"
    data_type: TYPE_STRING
    dims: [ 1 ]
  },
  {
    name: "USE_PROMPT"
    data_type: TYPE_BOOL
    dims: [ 1 ]
    optional: true
  }
]

output [
  {
    name: "EMBEDDING"
    data_type: TYPE_FP32
    dims: [ 1024 ]
  }
]
